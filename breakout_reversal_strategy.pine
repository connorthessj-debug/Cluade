//@version=5
strategy("Breakout & Reversal Strategy",
     overlay              = true,
     initial_capital      = 10000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 10,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.04,
     pyramiding           = 0,
     calc_on_every_tick   = false,
     process_orders_on_close = true)

// =============================================================================
// 1. INPUTS
// =============================================================================
grpVol      = "Volume"
volMaLen    = input.int(20,  "Volume MA Length",        minval = 1, group = grpVol)
volSpikeMul = input.float(2.0, "Volume Spike Factor",   minval = 0.1, step = 0.1, group = grpVol)

grpEng      = "Engulfing / ATR"
atrLen      = input.int(14,  "ATR Length",              minval = 1, group = grpEng)
atrMul      = input.float(1.5, "ATR Multiplier (range)", minval = 0.1, step = 0.1, group = grpEng)

grpSR       = "Support / Resistance"
srLookback  = input.int(50,  "S/R Lookback Bars",       minval = 5, group = grpSR)

grpEntry    = "Entry / Exit"
confirmBars = input.int(5,   "Breakout Confirmation Window (bars)", minval = 1, group = grpEntry)
rrRatio     = input.float(2.0, "Risk:Reward Ratio",     minval = 0.1, step = 0.1, group = grpEntry)
useReversal = input.bool(true, "Enable Reversal Entries", group = grpEntry)
useBreakout = input.bool(true, "Enable Breakout Entries", group = grpEntry)

grpFilter   = "Filters"
useTrendFilter = input.bool(false, "Use EMA Trend Filter", group = grpFilter)
emaLen         = input.int(200, "Trend EMA Length", minval = 1, group = grpFilter)

// =============================================================================
// 2. SUPPORT / RESISTANCE
// =============================================================================
// Use [1] so the current bar can break the prior structure without self-reference.
resistance = ta.highest(high, srLookback)[1]
support    = ta.lowest(low,  srLookback)[1]

// =============================================================================
// 3. VOLUME SPIKE
// =============================================================================
volMa      = ta.sma(volume, volMaLen)
volSpike   = volume > volMa * volSpikeMul

// =============================================================================
// 4. REVERSAL SIGNAL (Engulfing + ATR range filter + volume spike)
// =============================================================================
atrVal     = ta.atr(atrLen)
candleRng  = high - low

bullEngulf = close > open and close[1] < open[1] and
             close >= open[1] and open <= close[1]

bearEngulf = close < open and close[1] > open[1] and
             close <= open[1] and open >= close[1]

bigCandle  = candleRng > atrVal * atrMul

bullReversal = useReversal and bullEngulf and bigCandle and volSpike
bearReversal = useReversal and bearEngulf and bigCandle and volSpike

// =============================================================================
// 5. BREAKOUT SIGNAL
// =============================================================================
bullBreak = useBreakout and close > resistance and volSpike
bearBreak = useBreakout and close < support    and volSpike

// Track recent breakout state and price within the confirmation window
var int   bullBreakBar   = na
var int   bearBreakBar   = na
var float bullBreakLevel = na
var float bearBreakLevel = na

if bullBreak
    bullBreakBar   := bar_index
    bullBreakLevel := resistance
if bearBreak
    bearBreakBar   := bar_index
    bearBreakLevel := support

bullWindowOpen = not na(bullBreakBar) and (bar_index - bullBreakBar) <= confirmBars
bearWindowOpen = not na(bearBreakBar) and (bar_index - bearBreakBar) <= confirmBars

// First favorable close above the broken level within the window confirms entry
bullBreakConfirm = bullWindowOpen and close > bullBreakLevel and close > open
bearBreakConfirm = bearWindowOpen and close < bearBreakLevel and close < open

// =============================================================================
// 6. TREND FILTER (optional)
// =============================================================================
emaTrend  = ta.ema(close, emaLen)
longOK    = not useTrendFilter or close > emaTrend
shortOK   = not useTrendFilter or close < emaTrend

// =============================================================================
// 7. ENTRY / EXIT
// =============================================================================
longSignal  = (bullReversal or bullBreakConfirm) and longOK  and strategy.position_size == 0
shortSignal = (bearReversal or bearBreakConfirm) and shortOK and strategy.position_size == 0

// Stops are anchored to recent structure
longStop    = support
shortStop   = resistance

longRisk    = close - longStop
shortRisk   = shortStop - close

longTarget  = close + longRisk  * rrRatio
shortTarget = close - shortRisk * rrRatio

if longSignal and longRisk > 0
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = longTarget)

if shortSignal and shortRisk > 0
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = shortTarget)

// Reset breakout state once a trade is taken to avoid duplicate fills in the window
if longSignal
    bullBreakBar := na
if shortSignal
    bearBreakBar := na

// =============================================================================
// 8. PLOTS
// =============================================================================
plot(resistance, "Resistance", color = color.new(color.red,   0), style = plot.style_stepline)
plot(support,    "Support",    color = color.new(color.green, 0), style = plot.style_stepline)
plot(useTrendFilter ? emaTrend : na, "Trend EMA", color = color.new(color.orange, 0))

plotshape(bullReversal,     title = "Bull Reversal", style = shape.triangleup,   location = location.belowbar, color = color.new(color.lime,    0), size = size.tiny)
plotshape(bearReversal,     title = "Bear Reversal", style = shape.triangledown, location = location.abovebar, color = color.new(color.fuchsia, 0), size = size.tiny)
plotshape(bullBreakConfirm, title = "Bull Breakout", style = shape.labelup,      location = location.belowbar, color = color.new(color.green,   0), size = size.tiny, text = "B")
plotshape(bearBreakConfirm, title = "Bear Breakout", style = shape.labeldown,    location = location.abovebar, color = color.new(color.red,     0), size = size.tiny, text = "B")

bgcolor(volSpike ? color.new(color.yellow, 90) : na, title = "Volume Spike")

// =============================================================================
// 9. ALERTS
// =============================================================================
alertcondition(longSignal,  title = "Long Entry",  message = "Breakout/Reversal LONG signal")
alertcondition(shortSignal, title = "Short Entry", message = "Breakout/Reversal SHORT signal")
