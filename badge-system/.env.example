# Badge System Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Shared (same value on both Pi and Server) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BADGE_API_KEY=

# --- Raspberry Pi ---
# Badge server URL (use WireGuard VPN IP)
BADGE_SERVER_URL=https://10.0.0.1:5000

# Path to server's TLS certificate (for verification)
# Set to "false" during development only
BADGE_TLS_CERT=false

# Face recognition confidence threshold (0.0-1.0, lower = stricter)
BADGE_CONFIDENCE=0.45

# Detection model: "hog" (CPU, fast) or "cnn" (GPU, accurate)
BADGE_DETECTION_MODEL=hog

# Camera index (usually 0)
BADGE_CAMERA_INDEX=0

# Process every Nth frame (higher = less CPU)
BADGE_FRAME_SKIP=5

# Cooldown before re-printing for same person (seconds)
BADGE_COOLDOWN=300

# Device identifier
BADGE_DEVICE_ID=pi-front-desk-01

# Optional: encryption key for face encoding database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BADGE_ENCRYPTION_KEY=

# --- Kiosk Mode (license scanning) ---
# GPIO pin for the physical button (BCM numbering)
KIOSK_GPIO_PIN=17

# Auto-capture countdown (seconds). 0 = manual capture only.
KIOSK_COUNTDOWN=10

# Return to idle after this many seconds
KIOSK_IDLE_TIMEOUT=10

# Display window title
KIOSK_WINDOW_NAME=Badge Kiosk

# --- Server ---
# Gutenberg integration mode: watched_folder, cli, api, or direct_print
GUTENBERG_MODE=watched_folder

# Path to the directory Gutenberg watches for new badge jobs
GUTENBERG_WATCH_DIR=./badge_queue

# Gutenberg CLI path (if using cli mode)
GUTENBERG_CLI_PATH=gutenberg

# Gutenberg API URL (if using api mode)
GUTENBERG_API_URL=http://localhost:9100

# Badge template name
GUTENBERG_TEMPLATE=visitor_badge

# Company name on badges
BADGE_COMPANY_NAME=YOUR COMPANY

# Rate limit (requests per minute per IP)
BADGE_RATE_LIMIT=30
