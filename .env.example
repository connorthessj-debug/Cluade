# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Required for macro regime detection (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# --- Mobile web app auth (REQUIRED if exposing to the internet) ---
# Set both to enable HTTP Basic auth on the web server.
# If unset, anyone who can reach the server can use it (only OK on private LAN/Tailscale).
ACCESS_USER=trader
ACCESS_PASSWORD=
