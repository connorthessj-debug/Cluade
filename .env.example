# Claude API Key (required) - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Database path (SQLite - auto-created)
DB_PATH=data/optimizer.db

# Security key for web-triggered runs (generate a random string)
CRON_SECRET=change-this-to-a-random-string

# Loop interval in seconds (default: 600 = 10 minutes)
LOOP_INTERVAL=600

# Dashboard port (default: 8080)
DASHBOARD_PORT=8080

# Set to 1 for verbose console output
DEBUG=0
