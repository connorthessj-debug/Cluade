# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# Required for macro regime detection (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# --- Mobile web app auth (REQUIRED if exposing to the internet) ---
# Set both to enable HTTP Basic auth on the web server.
# If unset, anyone who can reach the server can use it (only OK on private LAN/Tailscale).
ACCESS_USER=trader
ACCESS_PASSWORD=

# --- Obsidian vault sync (vault-sync.bat / vault-sync.sh) ---
# URL of your deployed Render/Fly app (no trailing slash)
TRADING_OPS_URL=https://your-app.onrender.com
# Same credentials as ACCESS_USER/ACCESS_PASSWORD above
TRADING_OPS_USER=trader
TRADING_OPS_PASSWORD=
# Path to the 02_Projects folder in your Obsidian vault
VAULT_PROJECT_PATH=C:\Users\conno\OneDrive\ResearchOS\02_Projects
