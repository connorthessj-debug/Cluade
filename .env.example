# Claude API Key (required) - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# MySQL Database (Hostinger provides these in hPanel > Databases)
DB_HOST=localhost
DB_NAME=cold_email_optimizer
DB_USER=your_db_user
DB_PASS=your_db_password

# Security key for cron job endpoint (generate a random string)
CRON_SECRET=change-this-to-a-random-string

# Optional: Set to 1 to enable verbose logging
DEBUG=0
